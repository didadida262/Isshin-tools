{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Isshin Tools default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    "store:default",
    "http:default",
    "allow-http-get-text",
    "allow-netease",
    "allow-video-trim",
    "allow-bilibili",
    "allow-douyin",
    "dialog:allow-open",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://music.163.com/**" },
        { "url": "https://*.music.163.com/**" },
        { "url": "https://api.gold-api.com/**" },
        { "url": "https://open.er-api.com/**" },
        { "url": "https://fred.stlouisfed.org/**" },
        { "url": "https://api.allorigins.win/**" },
        { "url": "https://home.treasury.gov/**" },
        { "url": "https://hq.sinajs.cn/**" },
        { "url": "https://push2.eastmoney.com/**" },
        { "url": "https://push2delay.eastmoney.com/**" },
        { "url": "https://www.gold.org/**" },
        { "url": "https://gold.org/**" },
        { "url": "https://tradingeconomics.com/**" },
        { "url": "https://www.tradingeconomics.com/**" }
      ]
    },
    "opener:default"
  ]
}
